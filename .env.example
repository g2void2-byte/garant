# --- Environment ---
# development | test | staging | production. Production/staging enable
# fail-fast guards for Redis, proxy trust and secrets.
ENVIRONMENT=development

# --- Telegram bot ---
BOT_TOKEN=0000000000:REPLACE_ME

# --- CryptoBot (https://t.me/CryptoBot) ---
CRYPTOBOT_TOKEN=000000:REPLACE_ME

# --- Crystalpay v3 (alternative deposit provider) ---
# Optional. Both empty values disable the provider — ``services_wallet
# .create_deposit_invoice`` raises 502 if a request specifies
# ``provider="crystalpay"`` while either of these is blank, and the
# ``/api/payments/webhook/crystalpay`` endpoint returns 503 until
# ``CRYSTALPAY_SECRET`` is set.
#
# Where to get them: Crystalpay merchant cabinet → Кассы → open the
# cashbox you want to bill against:
#   - ``CRYSTALPAY_LOGIN``  — the cashbox login shown at the top of the page.
#   - ``CRYSTALPAY_SECRET`` — Settings / API → generate a secret. The
#     same value is used as the ``Authorization`` header on v3 API
#     calls AND as the salt for the ``sha1(invoice_id:secret)``
#     webhook signature, so rotating one without the other breaks both
#     sides at once.
CRYSTALPAY_LOGIN=
CRYSTALPAY_SECRET=

# --- Web app ---
WEBAPP_URL=https://your-domain.example/app
# Public backend origin for API/webhooks in split deploys. Keep empty for
# same-origin monolith dev; set both in production when frontend is under /app
# or on a separate CDN/domain.
PUBLIC_API_URL=https://your-domain.example
WEBHOOK_BASE_URL=https://your-domain.example
# Optional explicit CSP connect-src override. Empty means 'self' plus
# PUBLIC_API_URL origin when set.
CSP_CONNECT_SRC=
# Empty = enable only in production/staging. Set 1/0 to override.
ENABLE_HSTS=
# USD threshold for maker-checker on admin deal force-release/refund/split.
# Set 0 to disable; missing currency rates always require approval.
ADMIN_DEAL_APPROVAL_THRESHOLD_USD=10000
WEBAPP_PORT=8080
ALLOWED_ORIGINS=https://your-domain.example,http://localhost:5173

# --- Database (PostgreSQL only) ---
# Start a dev instance with:
#   docker run -d --name garant-pg \
#     -e POSTGRES_USER=garant -e POSTGRES_PASSWORD=garant -e POSTGRES_DB=garant \
#     -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql+asyncpg://garant:garant@localhost:5432/garant

# --- Redis (optional, P3.5) ---
# When set, WebSocket broadcasts go through Redis pub/sub so multiple
# backend workers / replicas share the same fan-out, and the rate
# limiter uses Redis counters instead of in-process state. Empty value
# keeps everything in-process (fine for single-worker dev).
#
# Start a dev instance with:
#   docker run -d --name garant-redis -p 6379:6379 redis:7-alpine
REDIS_URL=
REQUIRE_REDIS_FOR_RATE_LIMIT=0
REQUIRE_REDIS_FOR_2FA=0

# --- Security secrets ---
# Required in production/staging. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PIN_JWT_SECRET=
PIN_PEPPER=
MEDIA_URL_SIGNING_SECRET=

# Required behind a reverse proxy in production/staging, for example:
# TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXIES=

# --- Process composition (1 = on, 0 = off) ---
RUN_BOT=1

# --- Development helpers ---
ALLOW_UNSIGNED_INIT_DATA=0

# --- Bot menu external links (P3.2) ---
# Each value is the URL of an inline-keyboard button shown by the
# aiogram bot. Empty values hide the corresponding button — the
# menus collapse silently with no broken links.
#
#   BOT_FORUMS_URL          "🏛 Форумы" on the /profile keyboard.
#   BOT_COMMUNITY_CHAT_URL  "💬 Наш чат" on the /help keyboard.
#   BOT_ARBITRATION_URL     "⚖ Арбитраж" on the /help keyboard.
#   BOT_DOCS_URL            "📖 Инструкция" on the /help keyboard.
#   BOT_SUPPORT_USERNAME    Telegram username WITHOUT the leading ``@``;
#                           the bot renders it as ``https://t.me/<value>``
#                           for the "👤 Помощь" button on /help.
BOT_FORUMS_URL=
BOT_COMMUNITY_CHAT_URL=
BOT_ARBITRATION_URL=
BOT_DOCS_URL=
BOT_SUPPORT_USERNAME=
