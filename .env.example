# --- Telegram bot ---
BOT_TOKEN=0000000000:REPLACE_ME
BOT_USERNAME=your_bot_username
ADMIN_CHAT_ID=-1001234567890

# --- CryptoBot (https://t.me/CryptoBot) ---
CRYPTOBOT_TOKEN=000000:REPLACE_ME

# --- Web app ---
WEBAPP_URL=https://your-domain.example/app
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
ALLOWED_ORIGINS=https://your-domain.example,http://localhost:5173
JWT_TTL_SECONDS=86400

# --- Process composition (1 = on, 0 = off) ---
RUN_BOT=1
RUN_API=1

# --- Development helpers ---
# Set to 1 only in local development to accept dev initData
# generated by webapp.backend.security.build_dev_init_data.
ALLOW_UNSIGNED_INIT_DATA=0
