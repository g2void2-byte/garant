# --- Telegram bot ---
BOT_TOKEN=0000000000:REPLACE_ME

# --- CryptoBot (https://t.me/CryptoBot) ---
CRYPTOBOT_TOKEN=000000:REPLACE_ME

# --- Web app ---
WEBAPP_URL=https://your-domain.example/app
WEBAPP_PORT=8080
ALLOWED_ORIGINS=https://your-domain.example,http://localhost:5173

# --- Database (PostgreSQL only) ---
# Start a dev instance with:
#   docker run -d --name garant-pg \
#     -e POSTGRES_USER=garant -e POSTGRES_PASSWORD=garant -e POSTGRES_DB=garant \
#     -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql+asyncpg://garant:garant@localhost:5432/garant

# --- Redis (optional, P3.5) ---
# When set, WebSocket broadcasts go through Redis pub/sub so multiple
# backend workers / replicas share the same fan-out, and the rate
# limiter uses Redis counters instead of in-process state. Empty value
# keeps everything in-process (fine for single-worker dev).
#
# Start a dev instance with:
#   docker run -d --name garant-redis -p 6379:6379 redis:7-alpine
REDIS_URL=

# --- Process composition (1 = on, 0 = off) ---
RUN_BOT=1

# --- Development helpers ---
ALLOW_UNSIGNED_INIT_DATA=0

# --- Bot menu external links (P3.2) ---
# Empty values hide the corresponding inline button.
BOT_FORUMS_URL=
BOT_COMMUNITY_CHAT_URL=
BOT_ARBITRATION_URL=
BOT_DOCS_URL=
BOT_SUPPORT_USERNAME=
