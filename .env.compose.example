# Copy to `.env` (gitignored). `docker compose up` reads from here.
#
# All keys are optional EXCEPT ``POSTGRES_PASSWORD`` (audit §16.2.1) —
# the compose stack aborts at parse time if it isn't set. Everything
# else has a sensible default baked into ``docker-compose.yml``;
# override only what you need.

# --- Postgres credentials (V12-M10 / audit §16.2.1) ---
# ``POSTGRES_PASSWORD`` is REQUIRED. ``docker-compose.yml`` no longer
# carries a default for it (``${POSTGRES_PASSWORD:?...}``); a missing
# or empty value aborts ``docker compose up`` at parse time with a
# readable error rather than silently baking a literal placeholder
# into the running stack.
#
# Generate a fresh password for every clone:
#
#     echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)" >> .env
#
# The compose Postgres port is bound to ``127.0.0.1`` (see
# ``docker-compose.yml``), so the password protects against a
# misconfigured ``DOCKER_HOST_IFACE=0.0.0.0`` flip more than it
# protects against the open internet — rotate it (and audit the bind
# address) before exposing the port. The same value is reused in the
# ``DATABASE_URL`` env-var that the backend and ``migrate`` services
# read, so changing it here propagates to every consumer automatically.
POSTGRES_PASSWORD=

# --- Required only when you want the live bot polling Telegram ---
BOT_TOKEN=
CRYPTOBOT_TOKEN=
RUN_BOT=0

# --- Frontend / API ---
WEBAPP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# --- Auth bypass for local dev (NEVER enable in prod) ---
ALLOW_UNSIGNED_INIT_DATA=1

# --- Optional Redis (P3.5 multi-replica WS + rate-limit) ---
# Set to redis://redis:6379/0 to use the compose-managed Redis container.
# Empty = in-process broadcast + in-memory rate-limit.
REDIS_URL=

# Audit §4.5 — when running multiple backend replicas the admin/2fa
# enrolment flow (``/setup`` → ``/enable``) needs Redis or the
# in-process ``_pending_secrets`` fallback breaks the handoff. Set
# this to ``1`` on scale-out deploys so missing Redis surfaces as a
# loud HTTP 503 on the first enrolment attempt instead of users
# hitting "TOTP секрет не найден" silently hours later.
REQUIRE_REDIS_FOR_2FA=0

# --- Bot menu URLs (all optional; empty = hide the button) ---
BOT_FORUMS_URL=
BOT_COMMUNITY_CHAT_URL=
BOT_ARBITRATION_URL=
BOT_DOCS_URL=
BOT_SUPPORT_USERNAME=
