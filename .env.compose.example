# Copy to `.env` (gitignored). `docker compose up` reads from here.
#
# All keys are optional — defaults below are baked into docker-compose.yml.
# Override only what you need.

# --- Postgres credentials (V12-M10) ---
# Generate a fresh password for every clone — the literal value in this
# example is just a placeholder. Run:
#
#     POSTGRES_PASSWORD=$(openssl rand -hex 16)
#
# and paste it below before `docker compose up`. The compose service is
# bound to ``127.0.0.1`` (see ``docker-compose.yml``), so the password
# protects against a misconfigured ``DOCKER_HOST_IFACE=0.0.0.0`` flip
# more than it protects against the open internet; rotate it (and audit
# the bind address) before exposing the Postgres port. The same value
# is reused in the ``DATABASE_URL`` env-var that the backend and
# ``migrate`` services read, so override both if you change it.
POSTGRES_PASSWORD=garant-dev-please-rotate

# --- Required only when you want the live bot polling Telegram ---
BOT_TOKEN=
CRYPTOBOT_TOKEN=
RUN_BOT=0

# --- Frontend / API ---
WEBAPP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# --- Auth bypass for local dev (NEVER enable in prod) ---
ALLOW_UNSIGNED_INIT_DATA=1

# --- Optional Redis (P3.5 multi-replica WS + rate-limit) ---
# Set to redis://redis:6379/0 to use the compose-managed Redis container.
# Empty = in-process broadcast + in-memory rate-limit.
REDIS_URL=

# --- Bot menu URLs (all optional; empty = hide the button) ---
BOT_FORUMS_URL=
BOT_COMMUNITY_CHAT_URL=
BOT_ARBITRATION_URL=
BOT_DOCS_URL=
BOT_SUPPORT_USERNAME=
