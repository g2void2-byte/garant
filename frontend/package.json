{
  "name": "garant-miniapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "//": "V12-M3 — every range is pinned to an exact version (no carets) so a fresh ``npm install`` cannot float minors out from under the committed ``package-lock.json``. Dependabot (.github/dependabot.yml) opens grouped bump PRs each week; reviewers see one diff per bump rather than a silent transitive jump.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "generate:api-types": "python ../scripts/dump_openapi.py && openapi-typescript openapi.json -o src/api/openapi.generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "@telegram-apps/sdk-react": "2.0.25",
    "clsx": "2.1.1",
    "ky": "1.14.3",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "react-virtuoso": "4.18.7",
    "tailwind-merge": "2.6.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.8.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.6",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "6.4.2",
    "vitest": "4.1.6"
  }
}
