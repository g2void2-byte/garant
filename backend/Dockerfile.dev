# Dev image for the FastAPI backend.
#
# The image installs Python deps from pyproject.toml at build time, then
# expects the repository to be bind-mounted at /app at runtime so
# `uvicorn --reload` picks up source edits without rebuilds.
#
# `alembic upgrade head` runs on container start (see CMD); the FastAPI
# lifespan also runs it, so it's idempotent if you bypass the CMD.

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps: build tools for asyncpg/Pillow wheels, curl for healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps from pyproject.toml (cached layer when deps don't
# change). We copy only pyproject.toml first so source edits don't bust
# the dep-install cache.
COPY pyproject.toml ./
RUN pip install --upgrade pip \
    && pip install -e ".[dev]" \
    # `pip install -e .` needs the package to exist; we re-install at
    # runtime when the source is mounted, but for now create a stub:
    && mkdir -p backend/app \
    && touch backend/app/__init__.py

EXPOSE 8080

# Entrypoint: re-install the editable package (in case pyproject changed
# since image build), apply migrations, then start uvicorn with reload.
CMD ["sh", "-c", "pip install -e . --quiet && alembic upgrade head && uvicorn backend.app.main:app --host 0.0.0.0 --port 8080 --reload"]
