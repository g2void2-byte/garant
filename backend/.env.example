# Telegram bot
BOT_TOKEN=
BOT_USERNAME=AutoGarantBot
WEBAPP_URL=https://example.com

# Admin IDs (comma-separated Telegram user IDs)
ADMIN_IDS=

# Database — defaults to local SQLite
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./autogarant.db

# Service params
COMMISSION_PERCENT=5
INSURANCE_DEPOSIT=100

# Allow disabling bot polling (e.g. when running tests or only the API)
DISABLE_BOT=0
